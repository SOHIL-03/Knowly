# Knowly API settings. Copy to backend/.env for local runs; in Cloud Run set them as environment
# variables (secrets via Secret Manager references, never plain env). Names are case-insensitive.
# Every key is read by backend/app/config.py.

# ======================= Core =======================
# local = emulators + in-process background jobs; cloud = real Google Cloud (strict checks);
# test = automated tests only.
ENV=local
# Required. Firebase / Google Cloud project id.
GCP_PROJECT=demo-knowly
GCP_REGION=us-central1
# Browser origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ======================= Firebase emulators (local only) =======================
# Set these to use the local emulators; leave unset in cloud.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
STORAGE_EMULATOR_HOST=http://127.0.0.1:9199

# ======================= Text generation =======================
# true: every text call streams from Gemini (GEMINI_TEXT_MODEL) using the GEMINI_API_KEY_n keys below. A key that
# has not produced its first text within GEMINI_FIRST_TOKEN_TIMEOUT_SECONDS (or is out of quota, rate limited,
# rejected or unavailable) is cancelled and the next key is tried at once; OpenAI is the final fallback.
# false: OpenAI only, as before.
LLM_STREAMING_ENABLED=true
GEMINI_TEXT_MODEL=gemini-3.8-flash
# Thinking delays the first token. minimal | low | medium | high, or empty for the model's default.
GEMINI_TEXT_THINKING_LEVEL=minimal
GEMINI_FIRST_TOKEN_TIMEOUT_SECONDS=3
# Whether the OpenAI fallback also streams structured (JSON) output. Free-text answers always stream.
OPENAI_STREAMING_ENABLED=true

# ======================= OpenAI (text fallback; all text when LLM_STREAMING_ENABLED=false) =======================
# Used for parsing, plans, scripts, Ask, quizzes, grading and fact-checks when Gemini cannot answer.
# Backend only; never expose it to the frontend. This file is git-ignored; never commit keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Per-request timeout, and retries (after the first attempt) for 429 / 5xx / network errors.
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
# true = show every OpenAI response in the app and wait for "Generate Audio" before text-to-speech.
REVIEW_BEFORE_AUDIO=false

# ======================= Gemini (text generation, embeddings and all audio) =======================
# Option A: Gemini Developer API keys (this file is git-ignored; never commit keys).
# Every request starts with key 1 and moves to the next key (1 -> 2 -> ... -> 10) only when the
# current key is out of quota. Empty slots are skipped; set as many as you have.
# Note: keys from the same Google Cloud project share one quota, so use keys from different projects.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
# Single-key fallback, used only when none of GEMINI_API_KEY_1..10 is set.
GEMINI_API_KEY=
# Option B: Vertex AI with the service account's credentials (no key), for embeddings only. TTS still needs a key.
GEMINI_USE_VERTEX=false
GEMINI_VERTEX_LOCATION=global
# Model id (checked on ai.google.dev on 2026-10-15). Change only after checking the docs.
GEMINI_EMBED_MODEL=gemini-embedding-001
# Must match the vector index dimension in firestore.indexes.json (Firestore max is 2048).
EMBED_DIM=768

# ======================= Cloud Storage =======================
# Required. Bucket for audio, transcripts, source briefs and raw issue HTML (7-day lifecycle).
STORAGE_BUCKET=demo-knowly.appspot.com
SIGNED_URL_TTL_SECONDS=900
# Local: HMAC key for media links and internal endpoints. If empty, a random key is generated per
# process (fine for development). Not used in cloud (signed GCS URLs and OIDC are used there).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
LOCAL_MEDIA_SIGNING_KEY=
# Local media links. Empty = relative links (/api/media?...), which work from any device through
# the web app's dev proxy. Set an absolute URL only if the API is reached on a different origin.
PUBLIC_API_BASE_URL=

# ======================= Background work =======================
# inline = local thread pool (development only); cloud = Pub/Sub + Cloud Tasks + Cloud Run Jobs.
# INFO | DEBUG | TRACE (TRACE also enables HTTP library logs)
LOG_LEVEL=INFO
DISPATCH_MODE=inline
PUBSUB_TOPIC_RUN_BRIEFING=run-briefing
PUBSUB_TOPIC_GMAIL_EVENTS=gmail-events
TASKS_QUEUE=segment-audio
TASKS_LOCATION=us-central1
# Required in cloud: the API service URL that Pub/Sub, Cloud Tasks and Scheduler call, and the
# service account they sign OIDC tokens as.
INTERNAL_BASE_URL=
INTERNAL_INVOKER_SA=
# Optional: Cloud Run Job name; when set, run-briefing messages start this job instead of running
# the pipeline inside the API request.
BRIEFING_JOB_NAME=

# ======================= Audio: Gemini text-to-speech =======================
# Podcast segments use multi-speaker TTS (two hosts); spoken answers use single-speaker TTS.
# TTS runs on the Gemini API, so GEMINI_API_KEY_1 (or GEMINI_API_KEY) is required for audio even if text uses Vertex.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Speech-to-text for voice questions on the podcast page (Gemini audio understanding, same GEMINI_API_KEY_1).
# gemini-3.5-transcribe was checked against a real key; general models (gemini-2.5-flash returned not-found, others invent text from silence).
GEMINI_STT_MODEL=gemini-3.5-transcribe
# Prebuilt voices (see the voice list in the Gemini speech-generation docs). At most 2 hosts.
TTS_HOST_A_NAME=Maya
TTS_HOST_A_VOICE=Kore
TTS_HOST_B_NAME=Theo
TTS_HOST_B_VOICE=Puck
TTS_ANSWER_VOICE=Sulafat
# Script lines are sent in requests of about this many characters; the WAV parts are joined.
TTS_CHUNK_CHARS=2500

# ======================= Gmail (optional; sample mode works without it) =======================
# Same OAuth Web client as VITE_GOOGLE_OAUTH_CLIENT_ID.
GMAIL_OAUTH_CLIENT_ID=
# Cloud: name of the Secret Manager secret holding the client secret.
GMAIL_OAUTH_CLIENT_SECRET_NAME=
# Local only: the raw client secret (ignored when ENV=cloud).
GMAIL_OAUTH_CLIENT_SECRET=
# Full Pub/Sub topic for users.watch, e.g. projects/<project>/topics/gmail-events.
# Leave empty to skip Gmail push (scheduled generation still works).
GMAIL_PUBSUB_TOPIC_FULL=

# ======================= Limits and tuning (optional) =======================
DAILY_LIMIT_ASK=60
DAILY_LIMIT_DEEPER=10
DAILY_LIMIT_GENERATE=6
DAILY_LIMIT_TTS=120
MAX_REQUEST_BYTES=1000000
DEDUPE_COSINE_THRESHOLD=0.88
CONCEPT_MATCH_COSINE_THRESHOLD=0.72
ENRICH_TIMEOUT_SECONDS=8
ENRICH_MAX_CHARS=20000

# ======================= Semantic recommendations (optional) =======================
# Deterministic ranking from embeddings (app/recommend). No language model scores, classifies, reranks or
# explains stories. REC_ENABLED=false restores the original B6 scorer and the old story-embedding text.
REC_ENABLED=true
REC_RANKING_VERSION=semantic-v1
# Stories recommended per briefing (one wildcard is added on top when REC_WILDCARD_ENABLED).
REC_FINAL_COUNT=12
# Initial weight per facet type; feedback adjusts it within REC_WEIGHT_MIN..REC_WEIGHT_MAX.
REC_WEIGHT_PROJECT=1.0
REC_WEIGHT_GOAL=0.85
REC_WEIGHT_STACK=0.8
REC_WEIGHT_INTEREST=0.7
REC_WEIGHT_EXPERTISE=0.5
REC_WEIGHT_MIN=0.1
REC_WEIGHT_MAX=1.5
# Other facets within this share of the best facet's score are listed as secondary matches (display only).
REC_SECONDARY_MIN_RATIO=0.85
REC_SECONDARY_MAX=2
# Share of the score given to novelty (capped at 0.3), and the penalty for a story heard in the last 7 briefings.
REC_NOVELTY_WEIGHT=0.15
REC_HEARD_PENALTY=0.25
# 1.0 = pure relevance, lower = more diverse picks (maximal marginal relevance).
REC_MMR_LAMBDA=0.7
# Story-to-story cosine at which two stories are the same story (also used by B5 clustering when REC_ENABLED).
# gemini-embedding-001: true duplicates 0.89-0.99, distinct but related stories up to 0.91 (recsys_eval).
REC_DUPLICATE_THRESHOLD=0.93
# Mutes: gap of a story's cosine to a muted topic above the median candidate's cosine to it. At or above the
# exclude gap the story is dropped; between the penalty gap and it the story is penalised. Calibrated on
# gemini-embedding-001 at 768 dimensions; recheck with `python -m recsys_eval.run_eval --live --mute-diagnostics`
# whenever GEMINI_EMBED_MODEL or EMBED_DIM changes.
REC_MUTE_EXCLUDE_GAP=0.11
REC_MUTE_PENALTY_GAP=0.06
REC_MUTE_BASELINE=0.54
REC_MUTE_MIN_CANDIDATES=8
REC_MUTE_PENALTY=0.6
REC_MUTE_INCIDENTAL_PENALTY=0.1
REC_WILDCARD_ENABLED=true
REC_WILDCARD_MIN_RELEVANCE=0.25
REC_EXPLAIN_MIN_RELEVANCE=0.4
# Story embedding text: headline + blurb + the first REC_EXCERPT_CHARS characters of the linked article.
REC_EXCERPT_CHARS=600
REC_EMBED_BATCH_SIZE=50
# Extra attempts for transient (server/network) embedding errors, with exponential backoff, within one overall budget.
REC_EMBED_MAX_RETRIES=2
REC_EMBED_BACKOFF_SECONDS=1.0
REC_EMBED_TIMEOUT_SECONDS=30
# Optional: USD per million input tokens, used only to estimate embedding cost in logs.
REC_EMBED_PRICE_PER_MILLION_TOKENS=
# Feedback: how far one action moves the matched facet's learned weight, the bound on that learning,
# its half-life (about 30 days) and the "Knew this already" familiarity step and cap.
REC_FEEDBACK_SAVE=0.10
REC_FEEDBACK_ASK=0.05
REC_FEEDBACK_DEEPER=0.08
REC_FEEDBACK_LESS=-0.15
REC_FEEDBACK_MAX_DELTA=0.5
REC_FEEDBACK_HALF_LIFE_DAYS=30
REC_KNEW_STEP=0.25
REC_FAMILIARITY_CAP=0.6

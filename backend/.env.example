# Knowly API settings. Copy to backend/.env for local runs; in Cloud Run set them as environment
# variables (secrets via Secret Manager references, never plain env). Names are case-insensitive.
# Every key is read by backend/app/config.py.

# ======================= Core =======================
# local = emulators + in-process background jobs; cloud = real Google Cloud (strict checks);
# test = automated tests only.
ENV=local
# Required. Firebase / Google Cloud project id.
GCP_PROJECT=demo-knowly
GCP_REGION=us-central1
# Browser origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ======================= Firebase emulators (local only) =======================
# Set these to use the local emulators; leave unset in cloud.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
STORAGE_EMULATOR_HOST=http://127.0.0.1:9199

# ======================= OpenAI (required: all text generation) =======================
# Briefing parsing, plans, scripts, Ask, quizzes, grading and fact-checks all use this one key and
# model. Backend only; never expose it to the frontend. This file is git-ignored; never commit keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Per-request timeout, and retries (after the first attempt) for 429 / 5xx / network errors.
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
# true = show every OpenAI response in the app and wait for "Generate Audio" before text-to-speech.
REVIEW_BEFORE_AUDIO=false

# ======================= Gemini (required for embeddings and all audio; not used for text) =======================
# Option A: Gemini Developer API keys (this file is git-ignored; never commit keys).
# Every request starts with key 1 and moves to the next key (1 -> 2 -> ... -> 10) only when the
# current key is out of quota. Empty slots are skipped; set as many as you have.
# Note: keys from the same Google Cloud project share one quota, so use keys from different projects.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
# Single-key fallback, used only when none of GEMINI_API_KEY_1..10 is set.
GEMINI_API_KEY=
# Option B: Vertex AI with the service account's credentials (no key), for embeddings only. TTS still needs a key.
GEMINI_USE_VERTEX=false
GEMINI_VERTEX_LOCATION=global
# Model id (checked on ai.google.dev on 2026-10-15). Change only after checking the docs.
GEMINI_EMBED_MODEL=gemini-embedding-001
# Must match the vector index dimension in firestore.indexes.json (Firestore max is 2048).
EMBED_DIM=768

# ======================= Cloud Storage =======================
# Required. Bucket for audio, transcripts, source briefs and raw issue HTML (7-day lifecycle).
STORAGE_BUCKET=demo-knowly.appspot.com
SIGNED_URL_TTL_SECONDS=900
# Local: HMAC key for media links and internal endpoints. If empty, a random key is generated per
# process (fine for development). Not used in cloud (signed GCS URLs and OIDC are used there).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
LOCAL_MEDIA_SIGNING_KEY=
# Local media links. Empty = relative links (/api/media?...), which work from any device through
# the web app's dev proxy. Set an absolute URL only if the API is reached on a different origin.
PUBLIC_API_BASE_URL=

# ======================= Background work =======================
# inline = local thread pool (development only); cloud = Pub/Sub + Cloud Tasks + Cloud Run Jobs.
# INFO | DEBUG | TRACE (TRACE also enables HTTP library logs)
LOG_LEVEL=INFO
DISPATCH_MODE=inline
PUBSUB_TOPIC_RUN_BRIEFING=run-briefing
PUBSUB_TOPIC_GMAIL_EVENTS=gmail-events
TASKS_QUEUE=segment-audio
TASKS_LOCATION=us-central1
# Required in cloud: the API service URL that Pub/Sub, Cloud Tasks and Scheduler call, and the
# service account they sign OIDC tokens as.
INTERNAL_BASE_URL=
INTERNAL_INVOKER_SA=
# Optional: Cloud Run Job name; when set, run-briefing messages start this job instead of running
# the pipeline inside the API request.
BRIEFING_JOB_NAME=

# ======================= Audio: Gemini text-to-speech =======================
# Podcast segments use multi-speaker TTS (two hosts); spoken answers use single-speaker TTS.
# TTS runs on the Gemini API, so GEMINI_API_KEY_1 (or GEMINI_API_KEY) is required for audio even if text uses Vertex.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Prebuilt voices (see the voice list in the Gemini speech-generation docs). At most 2 hosts.
TTS_HOST_A_NAME=Maya
TTS_HOST_A_VOICE=Kore
TTS_HOST_B_NAME=Theo
TTS_HOST_B_VOICE=Puck
TTS_ANSWER_VOICE=Sulafat
# Script lines are sent in requests of about this many characters; the WAV parts are joined.
TTS_CHUNK_CHARS=2500

# ======================= Gmail (optional; sample mode works without it) =======================
# Same OAuth Web client as VITE_GOOGLE_OAUTH_CLIENT_ID.
GMAIL_OAUTH_CLIENT_ID=
# Cloud: name of the Secret Manager secret holding the client secret.
GMAIL_OAUTH_CLIENT_SECRET_NAME=
# Local only: the raw client secret (ignored when ENV=cloud).
GMAIL_OAUTH_CLIENT_SECRET=
# Full Pub/Sub topic for users.watch, e.g. projects/<project>/topics/gmail-events.
# Leave empty to skip Gmail push (scheduled generation still works).
GMAIL_PUBSUB_TOPIC_FULL=

# ======================= Limits and tuning (optional) =======================
DAILY_LIMIT_ASK=60
DAILY_LIMIT_DEEPER=10
DAILY_LIMIT_GENERATE=6
DAILY_LIMIT_TTS=120
MAX_REQUEST_BYTES=1000000
DEDUPE_COSINE_THRESHOLD=0.88
CONCEPT_MATCH_COSINE_THRESHOLD=0.72
ENRICH_TIMEOUT_SECONDS=8
ENRICH_MAX_CHARS=20000

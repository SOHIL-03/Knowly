# Frontend (Vite) settings. Copy to .env.local and fill in.
# VITE_ values are bundled into the browser, so only put PUBLIC values here, never secrets.
# Backend settings live in backend/.env.example.

# --- Firebase web app (Firebase console > Project settings > Your apps > Web app) ----------
# Required in production. With VITE_USE_EMULATORS=true they can stay empty (demo project).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# --- Local development against the Firebase emulators -------------------------------------
# true = connect Auth and Firestore to the local emulators (npm run emulators). In `npm run dev`
# this is the default when VITE_FIREBASE_API_KEY is empty, so local development needs no .env.local.
VITE_USE_EMULATORS=
# Optional overrides (defaults shown).
# VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# VITE_FIRESTORE_EMULATOR_PORT=8080

# --- Gmail read-only connection (optional; sample mode works without it) -------------------
# OAuth 2.0 *Web* client id from Google Cloud console > APIs & Services > Credentials.
# Must be the same client as GMAIL_OAUTH_CLIENT_ID in backend/.env. Add your site origin to
# "Authorised JavaScript origins".
VITE_GOOGLE_OAUTH_CLIENT_ID=

# --- Push notifications (optional) ----------------------------------------------------------
# Firebase console > Project settings > Cloud Messaging > Web Push certificates > Key pair.
VITE_FIREBASE_VAPID_KEY=

# --- Landing page (optional) ----------------------------------------------------------------
# Public URL of a ~20 second sample audio clip. Without it the landing shows a text preview.
VITE_SAMPLE_AUDIO_URL=

# --- Dev proxy (optional, read by vite.config.ts, not bundled) ------------------------------
# Where Vite forwards /api in development. Default http://localhost:8000
# KNOWLY_API_URL=http://localhost:8000

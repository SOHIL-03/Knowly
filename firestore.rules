rules_version = '2';
// Architecture v3 section 6.5.
// Browsers may only READ: the shared newsletter cache and their own user subtree.
// Every write goes through the API service (Admin SDK), so quiz grading, mastery maths and
// pipeline state cannot be changed from the browser.
service cloud.firestore {
  match /databases/{db}/documents {
    // Shared cache: readable by any signed-in user, written only by the server.
    match /items/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /senders/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Everything under a user is private to that user.
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Server only: raw issue metadata, quiz rubrics, deletion audit and anything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
